{
  "expo": {
    "name": "News Hammer",
    "slug": "headlines",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0D",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.johnny4091.newshammer",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.personal.headlines",
      "adaptiveIcon": {
        "backgroundColor": "#FF5A1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BarlowCondensed_700Bold.ttf",
            "./assets/fonts/BarlowCondensed_800ExtraBold.ttf",
            "./assets/fonts/BarlowCondensed_900Black.ttf"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "News Hammer uses your location to show the local weather.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/BarlowCondensed_800ExtraBold.ttf",
            "./assets/fonts/BarlowCondensed_900Black.ttf"
          ],
          "widgets": [
            {
              "name": "TopStory",
              "label": "Top story",
              "description": "Today's biggest story and how many outlets have it",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/top.png",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen|keyguard"
            },
            {
              "name": "Weather",
              "label": "Weather",
              "description": "The temperature and rain where you are",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/weather.png",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen|keyguard"
            },
            {
              "name": "YourTeam",
              "label": "Your team",
              "description": "Your starred team's live score",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/team.png",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen|keyguard"
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "scheme": "newshammer"
  }
}
